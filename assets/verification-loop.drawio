        <!-- Edge 3: n3 -> n1 feedback (dashed, accent) -->
        <mxCell id="e3" value="&lt;font style=&quot;font-size:11px&quot;&gt;reject → revise&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;dashed=1;strokeColor=#2563eb;strokeWidth=2;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="208"/>
              <mxPoint x="140" y="208"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Legend: solid = data flow -->
        <mxCell id="lg1" value="" style="endArrow=block;strokeColor=#64748b;strokeWidth=2;html=1;" edge="1" parent="1">
          <mxGeometry width="50" relative="1" as="geometry">
