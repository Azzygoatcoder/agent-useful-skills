        <mxCell id="lg1t" value="&lt;font style=&quot;font-size:11px&quot;&gt;data flow&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=11;" vertex="1" parent="1">
