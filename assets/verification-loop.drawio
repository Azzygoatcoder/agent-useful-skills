<mxfile host="app.diagrams.net">
  <diagram id="verification-loop" name="Verification Loop">
    <mxGraphModel dx="980" dy="360" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Node 1: LLM Drafts Artifacts -->
        <mxCell id="n1" value="&lt;b&gt;LLM Drafts Artifacts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gpt-image-2 · Qwen · DeepSeek&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="190" height="96" as="geometry"/>
        </mxCell>

        <!-- Node 2: Scripts Fix Format -->
        <mxCell id="n2" value="&lt;b&gt;Scripts Fix Format&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;llm.py · office_tools · latex_build&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#334155;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="190" height="96" as="geometry"/>
        </mxCell>

        <!-- Node 3: Native self-review -->
        <mxCell id="n3" value="&lt;b&gt;Native Self-Review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;same model reads the render&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#334155;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="470" y="60" width="190" height="96" as="geometry"/>
        </mxCell>

        <!-- Node 4: cross-model verification (FOCAL) -->
        <mxCell id="n4" value="&lt;b&gt;Cross-Model Verification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;vision · review · consistency&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#2563eb&quot;&gt;a DIFFERENT model judges&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=13;verticalAlign=middle;align=center;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="690" y="60" width="190" height="96" as="geometry"/>
        </mxCell>

        <!-- Edge 1: n1 -> n2 -->
        <mxCell id="e1" style="endArrow=block;strokeColor=#64748b;strokeWidth=2;html=1;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edge 2: n2 -> n3 -->
        <mxCell id="e2" style="endArrow=block;strokeColor=#64748b;strokeWidth=2;html=1;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edge 3: n3 -> n4 -->
        <mxCell id="e3" style="endArrow=block;strokeColor=#64748b;strokeWidth=2;html=1;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edge 4: n4 -> n1 feedback (dashed, accent) -->
        <mxCell id="e4" value="&lt;font style=&quot;font-size:11px&quot;&gt;reject → revise&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;dashed=1;strokeColor=#2563eb;strokeWidth=2;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="785" y="212"/>
              <mxPoint x="125" y="212"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Legend: solid = data flow -->
        <mxCell id="lg1" value="" style="endArrow=block;strokeColor=#64748b;strokeWidth=2;html=1;" edge="1" parent="1">
          <mxGeometry width="50" relative="1" as="geometry">
            <mxPoint x="30" y="264" as="sourcePoint"/>
            <mxPoint x="70" y="264" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lg1t" value="&lt;font style=&quot;font-size:11px&quot;&gt;draft → format → review&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="78" y="252" width="180" height="24" as="geometry"/>
        </mxCell>

        <!-- Legend: dashed = feedback -->
        <mxCell id="lg2" value="" style="endArrow=block;dashed=1;strokeColor=#2563eb;strokeWidth=2;html=1;" edge="1" parent="1">
          <mxGeometry width="50" relative="1" as="geometry">
            <mxPoint x="30" y="296" as="sourcePoint"/>
            <mxPoint x="70" y="296" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lg2t" value="&lt;font style=&quot;font-size:11px&quot;&gt;feedback / revise&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="78" y="284" width="180" height="24" as="geometry"/>
        </mxCell>

        <!-- Footnote: why a different model is required -->
        <mxCell id="note" value="&lt;font style=&quot;font-size:11px&quot;&gt;Why a different model: a self-review inherits the author&#39;s blind spots; only an independent model adds information.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="288" width="640" height="24" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
