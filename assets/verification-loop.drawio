<mxfile host="app.diagrams.net">
  <diagram id="verification-loop" name="Verification Loop">
    <mxGraphModel dx="760" dy="340" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="340" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Node 1: LLM Drafts Artifacts (External/Cloud) -->
